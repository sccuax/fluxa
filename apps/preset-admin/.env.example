# Copy this file to .env (gitignored via the repo root's blanket .env/.env.*
# pattern) and fill in the real value - get it from whoever ran
# `wrangler secret put ADMIN_API_TOKEN` for fluxa-data-client, or generate a
# new one and re-set it (this overwrites the old one, so every other
# preset-admin install would need updating too):
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#   echo <value> | pnpm exec wrangler secret put ADMIN_API_TOKEN   (run from apps/data-client)
VITE_ADMIN_API_TOKEN=
