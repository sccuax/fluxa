---
import { NAV, SITE, type Locale } from "@/config/site";
import { localizedPath, useTranslations } from "@/i18n";
import Logo from "@/components/ui/Logo.astro";
import { ButtonPrimary } from "@fluxa/ui";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useTranslations(locale);

const currentPath = Astro.url.pathname.replace(/\/$/, "") || "/";
const items = NAV.map((item) => {
  const href = localizedPath(item.href, locale);
  return { key: item.key, href, current: currentPath === href || currentPath.startsWith(`${href}/`) };
});

const linkClass =
  "text-text-md-medium text-text-white transition-colors hover:text-text-color-accent aria-[current=page]:text-text-color-accent";
// Lift on hover lives on a wrapper so it never clashes with ButtonPrimary's own transition-shadow.
const liftClass =
  "transition-transform duration-200 ease-out-expo hover:-translate-y-0.5 active:translate-y-0";
---

<!-- Floating pill: fixed and overlaying the hero (no layout space of its own),
     so every page starts under it. -->
<header data-site-header class="fixed inset-x-0 top-0 z-50 px-3 pt-3 md:px-8 md:pt-4">
  <div class="relative mx-auto max-w-[1360px]" data-nav>
    <div
      class="glass-border flex h-[77px] items-center justify-between rounded-full py-4 pl-8 pr-4 backdrop-blur-xl"
    >
      <a href={localizedPath("/", locale)} aria-label={SITE.name} class="text-text-white">
        <Logo class="h-6 w-auto" />
      </a>

      <!-- Spacing (desktop): items 40px apart; menu -> divider 40px; divider -> Login 52px;
           Login -> CTA 52px. Explicit margins, not `gap`, because each step differs. -->
      <div class="flex items-center">
        <nav aria-label="Primary" class="hidden items-center gap-10 md:flex">
          {
            items.map((item) => (
              <a href={item.href} aria-current={item.current ? "page" : undefined} class={linkClass}>
                {t.nav[item.key]}
              </a>
            ))
          }
        </nav>
        <span aria-hidden="true" class="ml-[40px] mr-[52px] hidden h-4 w-px bg-text-white/25 md:block"></span>
        <a href={SITE.loginUrl} class={`${linkClass} mr-[52px] hidden md:inline`}>{t.nav.login}</a>

        <span class={`${liftClass} hidden md:inline-block`}>
          <ButtonPrimary client:idle href={SITE.installUrl} size="md">
            {t.nav.cta}
            <svg width="6" height="10" viewBox="0 0 6 10" fill="none" aria-hidden="true">
            <path d="M1 1l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
          </svg>
          </ButtonPrimary>
        </span>

        <button
          type="button"
          data-nav-toggle
          aria-expanded="false"
          aria-controls="mobile-nav"
          aria-label={t.nav.menu}
          class="flex h-[45px] w-[45px] items-center justify-center rounded-full text-text-white hover:bg-text-white/10 md:hidden"
        >
          <svg width="18" height="12" viewBox="0 0 18 12" fill="none" aria-hidden="true">
            <path d="M1 1h16M1 11h16" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></path>
          </svg>
        </button>
      </div>
    </div>

    <!-- Mobile panel -->
    <div
      id="mobile-nav"
      hidden
      class="mt-2 rounded-24 border border-text-white/15 bg-background-dark/70 p-5 backdrop-blur-xl md:hidden"
    >
      <nav aria-label="Mobile" class="flex flex-col gap-4">
        {
          items.map((item) => (
            <a href={item.href} aria-current={item.current ? "page" : undefined} class={linkClass}>
              {t.nav[item.key]}
            </a>
          ))
        }
        <a href={SITE.loginUrl} class={linkClass}>{t.nav.login}</a>
        <span class={`${liftClass} flex justify-center`}>
          <ButtonPrimary client:idle href={SITE.installUrl} size="md">{t.nav.cta}</ButtonPrimary>
        </span>
      </nav>
    </div>
  </div>
</header>

<style>
  /* Glass pill, measured from the design reference (Nav-Menu.png). All alphas
     are white over the page background.
     Fill: near-black at the top easing to a faint lift at the bottom.
     Edge: a 1px ring (mask) built from three pieces so each part can differ:
       - straight edges:  top 0.43, bottom 0.29, visible along the whole length
       - right tip:       upper arc fades to NOTHING (0 between ~30deg and ~65deg),
                          lower arc visible at ~0.45-0.50
       - left tip:        upper arc is the brightest (0.64-0.73), lower arc fades
                          to NOTHING (~210deg-240deg)
     i.e. the top line dies where the right tip starts to round, and the
     bottom line dies where the left tip rounds. --cap is the tip radius
     (pill height 77px / 2). Angles below are conic angles: 0deg = top,
     clockwise. */
  .glass-border {
    --cap: 38.5px;
    position: relative;
    isolation: isolate;
    background: linear-gradient(to bottom, rgb(0 0 0 / 0.55), rgb(255 255 255 / 0.02));
  }
  /* Solid fill (background-dark #0B0D12): the hero timeline tweens --nav-solid 0 -> 1 on the header once the
     page turns light. It sits under the content and over the glass gradient. */
  .glass-border::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    border-radius: inherit;
    background: #0b0d12;
    opacity: var(--nav-solid, 0);
    pointer-events: none;
  }
  .glass-border::before {
    content: "";
    position: absolute;
    inset: 0;
    padding: 1px;
    border-radius: inherit;
    pointer-events: none;
    background-origin: border-box;
    background-repeat: no-repeat;
    background-image:
      /* right tip: outer half of the pill's right end */
      conic-gradient(
        from 0deg at 0% 50%,
        rgb(255 255 255 / 0.43) 0deg,
        rgb(255 255 255 / 0.1) 14deg,
        rgb(255 255 255 / 0) 28deg,
        rgb(255 255 255 / 0.02) 66deg,
        rgb(255 255 255 / 0.12) 82deg,
        rgb(255 255 255 / 0.3) 92deg,
        rgb(255 255 255 / 0.44) 105deg,
        rgb(255 255 255 / 0.5) 135deg,
        rgb(255 255 255 / 0.44) 165deg,
        rgb(255 255 255 / 0.29) 180deg
      ),
      /* left tip: outer half of the pill's left end */
      conic-gradient(
        from 0deg at 100% 50%,
        rgb(255 255 255 / 0.29) 180deg,
        rgb(255 255 255 / 0.07) 195deg,
        rgb(255 255 255 / 0) 210deg,
        rgb(255 255 255 / 0) 240deg,
        rgb(255 255 255 / 0.08) 255deg,
        rgb(255 255 255 / 0.41) 270deg,
        rgb(255 255 255 / 0.64) 285deg,
        rgb(255 255 255 / 0.73) 315deg,
        rgb(255 255 255 / 0.64) 345deg,
        rgb(255 255 255 / 0.43) 360deg
      ),
      /* straight edges between the two tips */
      linear-gradient(to bottom, rgb(255 255 255 / 0.43) 50%, rgb(255 255 255 / 0.29) 50%);
    background-position:
      right center,
      left center,
      center;
    background-size:
      var(--cap) 100%,
      var(--cap) 100%,
      calc(100% - 2 * var(--cap)) 100%;
    -webkit-mask:
      linear-gradient(#000 0 0) content-box,
      linear-gradient(#000 0 0);
    -webkit-mask-composite: xor;
    mask:
      linear-gradient(#000 0 0) content-box exclude,
      linear-gradient(#000 0 0);
  }
</style>

<script>
  const root = document.querySelector<HTMLElement>("[data-nav]");
  const toggle = root?.querySelector<HTMLButtonElement>("[data-nav-toggle]");
  const panel = root?.querySelector<HTMLElement>("#mobile-nav");

  const setOpen = (open: boolean) => {
    if (!toggle || !panel) return;
    toggle.setAttribute("aria-expanded", String(open));
    panel.hidden = !open;
  };

  toggle?.addEventListener("click", () => setOpen(toggle.getAttribute("aria-expanded") !== "true"));
  // Close on Escape, on link tap, and when growing past the mobile breakpoint.
  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape") setOpen(false);
  });
  panel?.addEventListener("click", (event) => {
    if ((event.target as HTMLElement).closest("a")) setOpen(false);
  });
  window.matchMedia("(min-width: 768px)").addEventListener("change", (event) => {
    if (event.matches) setOpen(false);
  });
</script>
