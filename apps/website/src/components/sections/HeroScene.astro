---
// The hero's backdrop: the Rive scene (assets/hero-footer.riv) EXACTLY as the footer shows it, minus the glass letters: the same
// 1440px-max, 1500x844-shaped stage aligned to the bottom of the screen, the same blurred mask and overlay
// (lib/footer/glassFooter.ts with `glass: false`, default options). That sameness is what makes the page loop seamless: at the
// end of the page the footer and the top of the page show the same picture (see lib/motion/pageLoop.ts).
//
// It replaces the old fluted-glass backdrop (kept in src/archive/flutes, see /experiments/fluted-glass). The hero's scroll timeline
// fades it out in phase 3 (Hero.astro) and then puts `data-scene-hidden` on the stage so the scene stops running.
// The Rive canvas is invisible and only there so the pointer reaches the scene's state machine; the GL canvas shows it.
---

<div class="hero-scene absolute inset-0 overflow-hidden bg-background-dark" aria-hidden="true" data-hero-scene>
  <div class="hero-scene__stage absolute inset-x-0 bottom-0 mx-auto w-full max-w-[1440px]" data-hero-stage>
    <canvas class="absolute inset-0 h-full w-full" data-hs-gl></canvas>
    <canvas class="absolute inset-0 h-full w-full opacity-0" data-hs-rive></canvas>
  </div>
</div>

<style is:global>
  /* The footer's stage shape: the scene is 1500x844. */
  .hero-scene__stage {
    aspect-ratio: 1500 / 844;
    min-height: 640px;
  }
</style>

<script>
  const root = document.querySelector<HTMLElement>("[data-hero-stage]");
  const gl = root?.querySelector<HTMLCanvasElement>("[data-hs-gl]");
  const rv = root?.querySelector<HTMLCanvasElement>("[data-hs-rive]");
  if (root && gl && rv) {
    // After the page has settled: the intro owns the first seconds, and the scene hides its own opening for another second.
    const start = async () => {
      try {
        const { mountFooterScene } = await import("@/lib/footer/glassFooter");
        const reduced = matchMedia("(prefers-reduced-motion: reduce)").matches;
        mountFooterScene(root, gl, rv, root, reduced, { glass: false });
      } catch (err) {
        console.warn("[hero] scene failed", err);
      }
    };
    if ("requestIdleCallback" in window) requestIdleCallback(() => void start(), { timeout: 1500 });
    else setTimeout(() => void start(), 400);
  }
</script>
