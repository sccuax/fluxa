---
// Section 5 (copy-paste/fluxa web/seccion-5.png): FAQ. Left = heading + the liquid 3D mark (lib/faq/liquidMark.ts,
// WebGL2, mounted lazily when the section is near the viewport); right = accordion (one open at a time, the open item
// draws the brand gradient line with ui/GradientBar). Texts: the `faq` dictionary (en/es), DRAFT copy to review.
import Eyebrow from "@/components/ui/Eyebrow.astro";
import Section from "@/components/layout/Section.astro";
import GradientBar from "@/components/ui/GradientBar.astro";
import { MARK_PATH } from "@/config/wordmark";
import type { Locale } from "@/config/site";
import { useTranslations } from "@/i18n";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useTranslations(locale).faq;

---

<Section id="faq" labelledby="faq-title" noTopRule bottomRule sectionClass="overflow-hidden bg-background-white-2">
  <div class="grid lg:grid-cols-2">
    <!-- Left: heading on top, the 3D mark at the bottom edge of the section -->
    <div class="relative flex flex-col px-6 pt-20 md:px-9 lg:min-h-[985px] lg:pt-[120px]">
      <div class="flex flex-col items-start gap-4" data-heading-reveal data-hr-start="88%">
        <Eyebrow data-hr-badge>{t.badge}</Eyebrow>
        <h2 id="faq-title" class="font-display text-header-h2 leading-[1.05] text-text-black" data-hr-title data-hr-gradient data-hr-sweep-out>
          {t.titlePre}<br />{t.titlePost}{t.titleAccent}
        </h2>
      </div>

      <!-- The canvas is bigger than the object (room to stretch); only the central part is the hit zone. -->
      <div class="relative mx-auto mt-6 aspect-square w-[min(720px,100%)] lg:-ml-[88px] lg:mb-[-56px] lg:mt-auto lg:w-[720px]" data-lm>
        <!-- No-WebGL fallback: the flat mark with the brand gradient (removed when the canvas takes over). -->
        <svg class="absolute left-[20%] top-[20%] h-[60%] w-[60%]" viewBox="0 0 32 32" aria-hidden="true" data-lm-fallback>
          <defs>
            <linearGradient id="lm-fallback" x1="0" y1="0" x2="1" y2="1">
              <stop offset="0" stop-color="#C9A8F2"></stop>
              <stop offset=".5" stop-color="#EFA7DA"></stop>
              <stop offset="1" stop-color="#6A7CE8"></stop>
            </linearGradient>
          </defs>
          <path d={MARK_PATH} fill="url(#lm-fallback)"></path>
        </svg>
        <!-- The progressive blur (0 at the middle -> 40px at the bottom) is done inside this canvas, in GL. -->
        <canvas class="pointer-events-none absolute inset-0 h-full w-full" aria-hidden="true" data-lm-canvas></canvas>
        <div class="absolute inset-[22%]" data-lm-hit></div>
      </div>
    </div>

    <!-- Right: accordion -->
    <ul class="flex flex-col lg:pl-20 lg:pt-[110px]" data-faq>
      {
        t.items.map((item, i) => (
          <li
            class="gbar-host faq-item relative border-b border-border-border px-6 last:border-b-0 md:px-9 lg:px-0"
            data-active={i === 0 ? "true" : "false"}
            data-scroll-reveal
            data-scroll-reveal-delay={Math.min(i, 5) * 0.07}
            style="--gbar-fill: 0.9s; --gbar-glow: 1.4s"
          >
            <h3>
              <button
                type="button"
                id={`faq-q-${i}`}
                aria-expanded={i === 0 ? "true" : "false"}
                aria-controls={`faq-a-${i}`}
                class="flex w-full cursor-pointer items-start justify-between gap-6 py-10 text-left font-display text-header-h5 text-text-black lg:pr-10"
              >
                <span>{item.q}</span>
                <span class="faq-icon mt-1 shrink-0 text-text-secondary" aria-hidden="true">
                  <!-- A "plus" made of two outlined pills. Open: the vertical pill collapses and only the horizontal one stays. -->
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M18 6.49805C21.0374 6.49827 23.4998 8.96068 23.5 11.998C23.5 15.0356 21.0375 17.4988 18 17.499L6 17.498C2.96231 17.498 0.500001 15.0357 0.5 11.998L0.506836 11.7158C0.653905 8.80951 3.0571 6.49902 6 6.49902L18 6.49805Z" stroke="currentColor"></path>
                    <path class="faq-ic-v" d="M6.5 6C6.50022 2.96264 8.96264 0.500224 12 0.5C15.0376 0.5 17.5008 2.9625 17.501 6L17.5 18C17.5 21.0377 15.0377 23.5 12 23.5L11.7178 23.4932C8.81146 23.3461 6.50098 20.9429 6.50098 18L6.5 6Z" stroke="currentColor"></path>
                  </svg>
                </span>
              </button>
            </h3>
            <div id={`faq-a-${i}`} role="region" aria-labelledby={`faq-q-${i}`} class="faq-a grid">
              <div class="overflow-hidden">
                <p class="max-w-[440px] pb-10 text-text-md-regular text-text-secondary">{item.a}</p>
              </div>
            </div>
            <GradientBar />
          </li>
        ))
      }
    </ul>
  </div>
</Section>

<style is:global>
  .faq-a {
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.5s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .faq-item[data-active="true"] .faq-a {
    grid-template-rows: 1fr;
  }
  .faq-ic-v {
    transform-box: fill-box;
    transform-origin: center;
    transition:
      transform 0.5s cubic-bezier(0.16, 1, 0.3, 1),
      opacity 0.35s ease;
  }
  .faq-item[data-active="true"] .faq-ic-v {
    transform: scaleY(0.05);
    opacity: 0;
  }
  @media (prefers-reduced-motion: reduce) {
    .faq-a,
    .faq-ic-v {
      transition: none;
    }
  }
</style>

<script>
  import { mountLiquidMark } from "@/lib/faq/liquidMark";

  // Accordion: one open at a time; clicking the open one closes it.
  const items = Array.from(document.querySelectorAll<HTMLElement>("[data-faq] .faq-item"));
  const setOpen = (item: HTMLElement, open: boolean) => {
    item.dataset.active = String(open);
    item.querySelector("button")?.setAttribute("aria-expanded", String(open));
  };
  for (const item of items) {
    item.querySelector("button")?.addEventListener("click", () => {
      const open = item.dataset.active !== "true";
      for (const other of items) setOpen(other, other === item ? open : false);
    });
  }

  // The 3D mark: start building it well before the section is on screen, on an idle moment (compiling the shaders
  // right when it scrolls in is what used to stall the page); the module also pauses itself off-screen.
  const wrap = document.querySelector<HTMLElement>("[data-lm]");
  const canvas = wrap?.querySelector<HTMLCanvasElement>("[data-lm-canvas]");
  const hit = wrap?.querySelector<HTMLElement>("[data-lm-hit]");
  if (wrap && canvas && hit) {
    const io = new IntersectionObserver(
      (entries) => {
        if (!entries.some((e) => e.isIntersecting)) return;
        io.disconnect();
        const mount = () =>
          mountLiquidMark(canvas, hit).then((mark) => {
            if (mark) wrap.querySelector("[data-lm-fallback]")?.remove();
            else canvas.remove();
          });
        if ("requestIdleCallback" in window) requestIdleCallback(() => void mount(), { timeout: 1500 });
        else setTimeout(() => void mount(), 200);
      },
      { rootMargin: "4000px" },
    );
    io.observe(wrap);
  }
</script>
