---
// The small gradient-outlined pill ("Pricing plans", "FAQ", ...) above a section heading. One component so every
// instance shares the same look and the same drop shadow (design spec). Extra attributes (data-hr-badge for the heading
// reveal, data-copy-badge for the hero...) and `class` are passed to the outer element.
interface Props {
  class?: string;
  [attr: string]: unknown;
}
const { class: className = "", ...attrs } = Astro.props;
---

<div class:list={["eyebrow rounded-full bg-gradient-gradient p-px", className]} {...attrs}>
  <span class="flex items-center gap-2 rounded-full bg-background-white py-1 pl-1.5 pr-3 text-text-sm-medium text-text-secondary">
    <span class="h-2.5 w-6 rounded-full bg-gradient-gradient" aria-hidden="true"></span>
    <slot />
  </span>
</div>

<style is:global>
  /* Eyebrow drop shadow (design spec). */
  .eyebrow {
    box-shadow:
      4px 21px 6px 0 rgba(11, 13, 18, 0),
      2px 13px 5px 0 rgba(11, 13, 18, 0.01),
      1px 8px 5px 0 rgba(11, 13, 18, 0.05),
      1px 3px 3px 0 rgba(11, 13, 18, 0.09),
      0 1px 2px 0 rgba(11, 13, 18, 0.1);
  }
</style>
