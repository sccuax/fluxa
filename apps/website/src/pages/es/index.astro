---
// Spanish home. Astro's i18n routing serves `/es`; the page body is identical
// and locale-driven, so it just re-renders the same components.
import BaseLayout from "@/layouts/BaseLayout.astro";
import Hero from "@/components/sections/Hero.astro";
import Features from "@/components/sections/Features.astro";
---

<BaseLayout>
  <Hero locale="es" />
  <Features locale="es" />
</BaseLayout>
