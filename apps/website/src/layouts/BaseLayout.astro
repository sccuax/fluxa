---
import "@/styles/global.css";
import Seo from "@/components/seo/Seo.astro";
import Header from "@/components/layout/Header.astro";
import Footer from "@/components/layout/Footer.astro";
import { resolveLocale, useTranslations } from "@/i18n";

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
  /** false: the page renders <Footer> itself (the home page does, inside the scroll stage that reveals it). */
  footer?: boolean;
}

const locale = resolveLocale(Astro.currentLocale);
const t = useTranslations(locale);
const { title = t.meta.title, description = t.meta.description, noindex, footer = true } = Astro.props;
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0b0d12" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link
      rel="preload"
      href="/fonts/bricolage-grotesque/BricolageGrotesque-SemiBold.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/general-sans/GeneralSans-Regular.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <Seo title={title} description={description} noindex={noindex} />
    <!-- `.js` gates the reveal-hidden state so the page is readable without JS. -->
    <script is:inline>
      document.documentElement.classList.add("js");
      // Every load starts at the top: the pinned hero cannot resume from a restored scroll position (a #hash link may).
      if ("scrollRestoration" in history) history.scrollRestoration = "manual";
      if (!location.hash) window.scrollTo(0, 0);
      window.addEventListener("pageshow", (e) => {
        if (e.persisted && !location.hash) window.scrollTo(0, 0);
      });
    </script>
  </head>
  <body>
    <Header locale={locale} />
    <main>
      <slot />
    </main>
    {footer && <Footer locale={locale} />}
    <script>
      import { initReveal } from "@/lib/motion/reveal";
      initReveal();
      import { initMagnet } from "@/lib/motion/magnet";
      initMagnet();
      // GSAP-based; they load it lazily and do nothing on pages without their markup.
      import { initHeadingReveal } from "@/lib/motion/headingReveal";
      import { initScrollDraw } from "@/lib/motion/scrollDraw";
      initHeadingReveal();
      initScrollDraw();
    </script>
  </body>
</html>
